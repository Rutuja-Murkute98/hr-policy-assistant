GOOGLE_API_KEY=your_gemini_key_here
HELPDESK_API_KEY=any_long_random_text

# Optional: the copy script asks for this if it isn't set
# CLOUD_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Leave unset on your PC. PostgreSQL then runs locally, in the pgdata folder.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: turns on the admin screen and endpoints for managing policies
# HELPDESK_ADMIN_KEY=another_long_random_text

# Optional: use other models. Each provider needs its own package and API key, such as
# langchain-anthropic and ANTHROPIC_API_KEY. A new embedding model needs its own indexing run.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=your_embedding_model
# MAX_DISTANCE=0.42

# Optional: chat model settings, using each provider's defaults if unset
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=1

# Optional: another chat model to use if the main one fails. It sends text to a second company.
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_MODEL=your_model

# Optional: stored chats and self-service tools
# CONVERSATION_RETENTION_DAYS=90
# AUDIT_RETENTION_DAYS=365
# SELF_SERVICE_ENABLED=true

# Optional: the evaluation's judge, which must differ from LLM_MODEL
# EVAL_JUDGE_MODEL=gemini-3.1-flash-lite

# Optional: search settings
# HYBRID_SEARCH=true
# RERANKER=flashrank

# Optional: speed. These are on unless set to false.
# CACHE_QUESTION_EMBEDDINGS=true
# SEARCH_WHILE_UNDERSTANDING=true
# CACHE_ANSWERS=true
# Skip the model reading a clear first message when its search is this strong
# SKIP_UNDERSTAND_WHEN_CLEAR=true
# SKIP_UNDERSTAND_CONFIDENCE=4.5
# A separate model to read each message and reword weak searches, such as a faster one. It sends text to that provider too.
# ROUTER_PROVIDER=google
# ROUTER_MODEL=your_faster_model

# Sign-in. "demo" uses shared keys and a chosen demo employee: never use it with real people.
# AUTH_MODE=demo
# With AUTH_MODE=password, people create an account and sign in with an email and password.
# Make the first HR admin with:  venv\Scripts\python -m ops.create_admin you@company.com
# ALLOW_SIGNUP=true
# SIGNUP_EMAIL_DOMAINS=company.com
# With AUTH_MODE=oidc, shared keys stop working and people sign in with your provider.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
# The first platform admins, comma-separated. They can add organisations.
# PLATFORM_ADMIN_EMAILS=you@example.com

# Optional: logs, metrics and tracing. See docs/OPERATIONS.md.
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# METRICS_RETENTION_DAYS=90
# LLM_PRICE_INPUT_PER_MILLION=0
# LLM_PRICE_OUTPUT_PER_MILLION=0
# Sends prompts to Langfuse, so it's off unless both keys are set. Needs requirements-tracing.txt.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# Optional: rate limits. Counts are kept in PostgreSQL unless REDIS_URL is set.
# RATE_LIMIT_TENANT_PER_MINUTE=30
# RATE_LIMIT_LOGIN_PER_MINUTE=30
# REDIS_URL=redis://localhost:6379/0

# Only for the Slack bot in integrations/slack_bot.py
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_APP_TOKEN=xapp-your-app-token
